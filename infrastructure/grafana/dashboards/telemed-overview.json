  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(amrutam_http_requests_total[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "HTTP Request Latency (p95 & p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(amrutam_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(amrutam_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Booking Outcomes (Success vs Conflict Double-Bookings)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(amrutam_booking_operations_total[1m])) by (outcome)",
          "legendFormat": "Outcome: {{outcome}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Idempotency Hits & Replays",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(amrutam_idempotency_hits_total[1m])) by (result)",
          "legendFormat": "Result: {{result}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "refresh": "5s",
